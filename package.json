{
  "name": "@iricity/frontier-shared",
  "version": "0.5.1",
  "description": "Canonical JSON, hashing, ed25519 identity, signed envelopes, signed receipt chains and state-record constructors shared by the frontier stacks. Reference primitives for the state protocol, with published conformance vectors.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./conformance": "./conformance/run.js",
    "./conformance/vectors.json": "./conformance/vectors.json"
  },
  "files": [
    "src",
    "conformance/run.js",
    "conformance/vectors.json",
    "conformance/vectors.lock.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "conformance": "node conformance/run.js",
    "conformance:build": "node conformance/build-vectors.js"
  },
  "keywords": [
    "canonical-json",
    "rfc8785",
    "ed25519",
    "did-key",
    "receipts",
    "provenance",
    "space"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iricity/iricity-frontier-shared.git"
  },
  "homepage": "https://github.com/iricity/iricity-frontier-shared#readme",
  "bugs": {
    "url": "https://github.com/iricity/iricity-frontier-shared/issues"
  }
}
